# API 配置示例
# 复制此文件为 .env 并填写真实配置（可选，也可以直接在 src/config/apiConfig.js 中配置）

# 应用密钥（必填）
VITE_BOT_APP_KEY=your_bot_app_key_here

# 访客业务 ID（必填）
VITE_VISITOR_BIZ_ID=visitor_demo_001

# 模型名称（可选）
# 可选值：hunyuan, hunyuan-13B, hunyuan-turbo, lke-deepseek-r1, lke-deepseek-v3
VITE_MODEL_NAME=

# 联网搜索（可选）
# 可选值：enable, disable
VITE_SEARCH_NETWORK=

# 流式回复频率（可选，默认 5）
VITE_STREAMING_THROTTLE=5
